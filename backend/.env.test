# Test environment. Loaded for APP_ENV=test; real environment variables win.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# Nothing in the suite may reach this. config/services_test.yaml binds every
# HTTP client to a MockHttpClient, so OpenAI cannot be called and the suite
# cannot spend money. The host is here only to satisfy the container.
ML_PROCESSOR_HOST=http://127.0.0.1:8201
