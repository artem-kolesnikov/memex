<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <ini name="memory_limit" value="512M" />
        <server name="APP_ENV" value="test" force="true" />
        <!-- Error responses render like the box rather than as Symfony's HTML
             debug page, which dumps request arguments into the output and made
             a 404 look like a content leak. -->
        <server name="APP_DEBUG" value="0" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <!-- Everything outside tests/Database. -->
        <testsuite name="unit">
            <directory>tests</directory>
            <exclude>tests/Database</exclude>
        </testsuite>
        <!-- Booted kernel over real SQLite files in a fresh data directory. -->
        <testsuite name="database">
            <directory>tests/Database</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true" restrictNotices="true" restrictWarnings="true" restrictDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>

    <extensions>
    </extensions>
</phpunit>
