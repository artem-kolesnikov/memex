# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Set the real value in .env.local (never committed) — project rule: no secrets in git.
APP_SECRET=
###< symfony/framework-bundle ###

###> app ###
# The localhost Node service (see services/ in the monorepo)
ML_PROCESSOR_HOST=http://127.0.0.1:8201

# The public origin of this installation, with no trailing slash
# (e.g. https://memex.tools). Used to build the OAuth redirect URI and the
# invite links the console prints. Empty = derive from the incoming request,
# which is fine locally. Set the real value in .env.local / the box's .env.
APP_BASE_URL=

# The TLS proxy in front of memex (Caddy, a load balancer), when there is one:
# its addresses or ranges, comma-separated (172.16.0.0/12), or REMOTE_ADDR for
# whatever connects. Its X-Forwarded-* headers then give the visitor's scheme,
# host and address. Empty = nothing in front, and those headers are ignored.
TRUSTED_PROXIES=

# Social sign-in. Empty = that provider is not offered on the sign-in screen,
# so this file staying empty is the normal, working state.
#
# The real values go in .env.local, HERE AND ON THE BOX. Never in this file:
# deploy.yml rsyncs this one over /var/www/api/.env on every merge and excludes
# only *.local, so a secret written here works until the next deploy deletes it.
#   Google: console.cloud.google.com > APIs & Services > Credentials >
#           OAuth client ID (Web application). Authorised redirect URI:
#           https://memex.tools/api/auth/google/callback
#   GitHub: github.com/settings/developers > New OAuth App. Callback URL:
#           https://memex.tools/api/auth/github/callback
#   Microsoft: entra.microsoft.com > App registrations > New registration.
#           Supported account types: "Accounts in any organizational directory
#           and personal Microsoft accounts" — anything narrower shuts out
#           either the corporate case or the person with only an Outlook
#           address. Redirect URI (type Web):
#           https://memex.tools/api/auth/microsoft/callback
#           Then Certificates & secrets > New client secret (24 months, the
#           maximum), and Token configuration > Add optional claim > ID >
#           `xms_edov`, WITHOUT which memex cannot tell a proven work address
#           from one an administrator typed, and falls back to the sign-in name
#           for every account in every tenant.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Sign in with Apple. Four values rather than two, and three of the four are
# not secret — only the .p8 is.
#
#           APPLE_OAUTH_CLIENT_ID is the SERVICES ID (e.g. tools.memex.signin),
#           not the App ID: Apple makes you register an App ID first, purely so
#           the Services ID can name it as its primary, and no app ever ships
#           under it. The Services ID is where memex.tools and the return URL
#           https://memex.tools/api/auth/apple/callback are configured.
#
#           APPLE_OAUTH_PRIVATE_KEY is a PATH to the .p8 downloaded from
#           Keys > (key with Sign in with Apple enabled). Apple generates that
#           file once and keeps no copy; losing it means revoking the key and
#           registering another, which changes APPLE_OAUTH_KEY_ID with it. PEM
#           contents are accepted too, for a host that can only pass strings.
#
#           There is no expiry line here, unlike Microsoft's. Apple refuses any
#           client secret lasting more than six months, so memex signs a fresh
#           one for every token exchange instead of holding a date it would
#           eventually forget.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
###< app ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
